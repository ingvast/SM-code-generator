# Phoenix export fixture: quoting, multi-line code, guard ordering (incl. JS
# integer-key ordering), relative/absolute targets. Expected output generated by SM-gui.
SM-builder-version: "0.6.0"
initial: A
states:
  A:
    initial: a1
    states:
      a1:
        entry: |
          print("hi: there")
            x = 'y' # comment
          - dash
        exit: "yes"
        transitions:
          - guard: "ctx.s == 'on' and x: 1"
            to: ../../B
          - guard: "true"
            to: a2
          - to: /A/a2
          - guard: "123"
            to: .
      a2:
        transitions:
          - to: ../../B/b1
      "weird name":
        entry: "null"
  B:
    initial: b1
    states:
      b1: {}
  C: {}
