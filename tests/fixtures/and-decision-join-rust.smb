SM-builder-version: "0.6.0"
language: rust

# Regression test (Rust): an AND-join source that reaches the join THROUGH a
# decision. See and-decision-join-python.smb for the full description.
#
# RegA/Working -> @A1 directly (ready at step >= 1); RegB/Working -> @D1 -> @A1
# via a decision guarded by step >= 3. The join must wait for step >= 3.

context: |
    pub step: i32,

context_init: |
    step: 0,

hooks:
  transition: |
    println!("{:02}: {} -> {}", ctx.step, t_src, t_dst);

initial: Parallel

states:
  Parallel:
    orthogonal: true
    ands:
      A1:
        - to: /Done
    states:
      RegA:
        initial: Working
        states:
          Working:
            transitions:
              - guard: ctx.step >= 1
                to: "../../@A1"
      RegB:
        initial: Working
        decisions:
          # Two branches to the same AND -> RegB has TWO edges into A1, so the
          # gate that checks RegB must OR them (exercises BOOL_OR). Their union
          # is step >= 3, so the join still fires at step 3.
          D1:
            - guard: ctx.step >= 5
              to: "../../@A1"
            - guard: ctx.step >= 3
              to: "../../@A1"
        states:
          Working:
            transitions:
              - to: "@D1"

  Done:
    transitions:
      - to: null
