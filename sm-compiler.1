.SH Integration & API
.SS Rust Integration
The generated code provides a \f[CR]StateMachine\f[R] struct.
You must initialize it and call \f[CR]tick()\f[R] cyclically.
.IP
.EX
\f[B]mod\f[R] statemachine;
\f[B]use\f[R] statemachine::StateMachine;

\f[B]fn\f[R] main() {
    \f[B]let\f[R] \f[B]mut\f[R] sm = StateMachine::new();

    \f[B]while\f[R] sm.is_running() {
        sm.ctx.now += 0.1;  \f[I]// Advance logical time\f[R]
        sm.tick();
        println!(\(dqState: {}\(dq, sm.get_state_str());
        std::thread::sleep(std::time::Duration::from_millis(100));
    }
}
